{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uclu_kaydi_v1",
  "title": "Üçlü kaydı, sürüm 1 (V-012, K-004)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sema_surumu", "ozne", "iliski", "nesne", "kaynak", "guven", "adim", "ozet"],
  "properties": {
    "sema_surumu": {"const": "1"},
    "ozne": {"type": "integer", "minimum": 0},
    "iliski": {"type": "string", "pattern": "^[a-zçğıöşü_]+$", "minLength": 1},
    "nesne": {"type": "integer", "minimum": 0},
    "kaynak": {"enum": ["kullanıcı", "çekirdek", "LLM", "KeNet", "Wikidata", "üreteç"]},
    "guven": {"type": "number", "minimum": 0, "maximum": 1},
    "adim": {"type": "integer", "minimum": 0},
    "ozet": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

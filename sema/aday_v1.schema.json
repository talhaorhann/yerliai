{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aday_v1",
  "title": "H2 tek aday şeması, sürüm 1 (v1 §2 ve §4.5; K-041): baş, gövde, kaynak, tanık, sürüm",
  "description": "Okunuş (A, r, B) = B, A'nın r'sidir. Baş = sonuc, gövde = halkalar (1–3). Kapsam alanı yoktur: kapsamı yalnız geçit türetir. oi=true ise gövdedeki bütün değişkenler farklı kişilere bağlanır ve farkli boş kalır.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sema_surumu",
    "kimlik",
    "halkalar",
    "sonuc",
    "farkli",
    "oi",
    "kaynak",
    "tanik_ozeti",
    "surum"
  ],
  "properties": {
    "sema_surumu": {
      "const": "1"
    },
    "kimlik": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1,
      "maxLength": 80
    },
    "halkalar": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gen",
          "sol",
          "sag"
        ],
        "properties": {
          "gen": {
            "type": "string",
            "pattern": "^[a-zçğıöşü_]+$"
          },
          "sol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*$"
          },
          "sag": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*$"
          }
        }
      },
      "uniqueItems": true
    },
    "sonuc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gen",
        "sol",
        "sag"
      ],
      "properties": {
        "gen": {
          "type": "string",
          "pattern": "^[a-zçğıöşü_]+$"
        },
        "sol": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*$"
        },
        "sag": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*$"
        }
      }
    },
    "farkli": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*$"
        }
      }
    },
    "oi": {
      "type": "boolean"
    },
    "kaynak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tur",
        "aile",
        "tohum",
        "ust"
      ],
      "properties": {
        "tur": {
          "enum": [
            "m0",
            "m0_budama",
            "rastgele_ornekleme",
            "rastgele_mutasyon",
            "mutasyon_klonal",
            "sifir_sablon",
            "kirmizi_gorunur",
            "kirmizi_gizli",
            "b2a_tohumu",
            "terfi"
          ]
        },
        "aile": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "tohum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ust": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    },
    "tanik_ozeti": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "surum": {
      "type": "integer",
      "minimum": 1
    },
    "okunus": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kirmizi_dosyasi_v1",
  "title": "H2 kırmızı takım dosyası, sürüm 1 (ÖK-005 taslağı §4 madde 19; K-041): aileler ve sahte aday kayıtları",
  "description": "Her aday ayrıca aday_v1 şemasıyla doğrulanır. Gizli dosyayı kodlayıcı açmaz; araç yalnız biçimi denetler ve sayıları yazar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sema_surumu",
    "dosya_turu",
    "yazan",
    "tarih",
    "aileler",
    "adaylar"
  ],
  "properties": {
    "sema_surumu": {
      "const": "1"
    },
    "dosya_turu": {
      "enum": [
        "kirmizi_gorunur",
        "kirmizi_gizli"
      ]
    },
    "yazan": {
      "type": "string",
      "minLength": 1
    },
    "tarih": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "aileler": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ad",
          "aciklama"
        ],
        "properties": {
          "ad": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "aciklama": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adaylar": {
      "type": "array",
      "minItems": 1
    }
  }
}
